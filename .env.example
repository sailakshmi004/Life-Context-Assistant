# Awarely (Life Context Assistant) - Environment Configuration Template
# Copy this file to .env.local for local development. Never commit .env or secrets to Git.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Database & Auth - configured in future phases)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is server-side only. NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Weather API (Weather data provider - configured in future phases)
# Keep server-side only so the API key is not leaked to client browsers
WEATHER_API_KEY=your-weatherapi-key-here
