# Awarely (Life Context Assistant) - environment template
# Copy to .env for docker compose, or .env.local for `npm run dev`.
# Never commit the real .env file.
#
# NOTE: server configuration deliberately uses non-NEXT_PUBLIC names so Next.js
# does not inline build-time values into the Docker image.

# -----------------------------------------------------------------------------
# Public address / reverse proxy
# -----------------------------------------------------------------------------
# Direct Caddy mode: set SITE_ADDRESS to a domain/sslip.io host for automatic
# HTTPS, e.g. awarely.203.0.113.10.sslip.io. Use :80 for local/LAN only.
#
# Shared-proxy mode (existing Nginx/Caddy/Coolify on the VPS): leave Caddy
# stopped and point the existing proxy at 127.0.0.1:APP_PORT.
SITE_ADDRESS=:80

# Host ports for direct Caddy mode. Change these if 80/443 are already in use.
HTTP_PORT=80
HTTPS_PORT=443

# Loopback-only app port. Direct mode uses Caddy internally; shared-proxy mode
# points the existing proxy here. Change if 3000 is already in use.
APP_PORT=3000

# Native PM2 deployment only (ignored by Docker):
# Change PORT if 3000 is already used on the server, then update proxy_pass
# in the Nginx site config to the same port.
PORT=3000
HOSTNAME=127.0.0.1

# -----------------------------------------------------------------------------
# Passcode gate (single-user access)
# -----------------------------------------------------------------------------
# The passphrase you will type on the unlock screen. Use a long random phrase.
APP_PASSCODE=replace-with-a-long-private-passphrase
# HMAC key for the 30-day session cookie. Generate with `openssl rand -hex 32`.
APP_SESSION_SECRET=replace-with-64-hex-characters
# Shared secret used by the scheduler container. Generate separately.
CRON_SECRET=replace-with-another-64-hex-characters

# -----------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# -----------------------------------------------------------------------------
# Direct Postgres connection string for `npm run db:migrate`
# Supabase -> Project Settings -> Database -> Connection string -> URI (port 5432)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
# SERVER-SIDE ONLY. Used behind the passcode gate; RLS denies the anon key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# -----------------------------------------------------------------------------
# WeatherAPI (https://www.weatherapi.com/)
# -----------------------------------------------------------------------------
WEATHER_API_KEY=your-weatherapi-key-here

# -----------------------------------------------------------------------------
# Web Push (VAPID). Generate with `npm run generate:secrets`.
# VAPID_SUBJECT must be a mailto: or https: URL.
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
