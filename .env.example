# Awarely (Life Context Assistant) - Environment Configuration
# Copy this file to .env.local for local development. Never commit .env or secrets to Git.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase Configuration (Phase 2)
# Find these in your Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------

# Project URL (Safe for client browsers)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Project Anon Key (Safe for client browsers - public anonymous access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service Role Key (SERVER-SIDE ONLY - NEVER expose with NEXT_PUBLIC_ prefix)
# Used by Next.js Route Handlers to bypass RLS before authentication is added in Phase 3
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# -----------------------------------------------------------------------------
# Weather API (Phase 4 / Future Phase)
# -----------------------------------------------------------------------------
WEATHER_API_KEY=your-weatherapi-key-here
